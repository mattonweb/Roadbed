<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="KeePassLib.Standard" Version="2.57.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.402">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!--
		  KeePassLib.Standard 2.57.1 transitively pulls in System.Security.Cryptography.Xml 8.0.1,
		  which has known high-severity vulnerabilities (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf).
		  Pin the package directly to a patched version so the override flows to every consumer
		  of this project.
		  10.0.13 is the floor for the 2026-10-13 .NET advisories (Xml: GHSA-c399-9853-6jmj, GHSA-7hqp-7c5m-4vq6, GHSA-r955-8q5j-3h83; Pkcs, via Xml: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
		-->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Roadbed.Common\Roadbed.Common.csproj" />
	</ItemGroup>

</Project>
